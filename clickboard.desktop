[Desktop Entry]
Type=Application
Name=Clickboard
Comment=The clipboard that follows you between machines
Exec=clickboard
Icon=edit-paste
Terminal=false
Categories=Utility;
StartupNotify=false
Actions=Toggle;Settings;Quit;

[Desktop Action Toggle]
Name=Pause / resume sync
Exec=clickboard --toggle

[Desktop Action Settings]
Name=Settings
Exec=clickboard --settings

[Desktop Action Quit]
Name=Quit Clickboard
Exec=clickboard --quit
